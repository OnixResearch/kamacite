<kamacite-preserves-schema-artifact-v1 {
  family: "bend-hvm2-pilot-decision"
  version: "v1"
  schema-id: "kamacite.bend-hvm2-pilot-decision.v1"
  states: ["adopt" "defer" "reject"]
  adopt-rule: "exact cohort, proof handoff, three-route equality, limits, stability, and declared performance targets all pass"
  defer-rule: "execution, resource, stability, or performance evidence has an exact unresolved blocker"
